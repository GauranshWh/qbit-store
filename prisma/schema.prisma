generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  category     String   // "hft-server" | "firewall" | "switch" | "storage" | "other"
  shortDesc    String
  longDesc     String
  specs        Json
  datasheetUrl String?
  images       String[]
  priceType    String   // "FIXED" | "QUOTE"
  priceCents   Int?
  stock        Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Quote {
  id           String   @id @default(uuid())
  companyName  String
  contactName  String
  email        String
  phone        String?
  productSlug  String?
  requirements Json
  status       String   @default("NEW") // "NEW" | "CONTACTED" | "QUOTED" | "WON" | "LOST"
  createdAt    DateTime @default(now())
}

model Order {
  id              String   @id @default(uuid())
  stripeSessionId String   @unique
  email           String
  items           Json
  totalCents      Int
  status          String
  createdAt       DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
